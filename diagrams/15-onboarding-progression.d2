# Onboarding progression — Stribog UI/UX Standard §18

direction: right

arrival: {
  label: "first-run arrival\n(account created,\nempty workspace)"
  shape: oval
  style.fill: "#EEF2FF"
}

guided_setup: {
  label: "guided setup\n(progressive disclosure,\nfinite step count,\nresumable)"
  style.fill: "#FEF3E8"
}

sample_data_choice: {
  label: "Sample data\nor start fresh?"
  shape: diamond
  style.fill: "#FFF7CC"
}

sample: {
  label: "sample data loaded\n(clearly labelled,\nremovable in one action)"
  style.fill: "#DBEAFE"
}

fresh: {
  label: "empty workspace\n(empty-state copy\nnames next action)"
  style.fill: "#E5E7EB"
}

first_task: {
  label: "first-task path\n(biased toward one\ncompleted task)"
  style.fill: "#FEF3E8"
}

aha: {
  label: "aha moment\n(smallest meaningful\nend state — declared\nin annex per §18.1)"
  shape: oval
  style.fill: "#DEFBE5"
  style.stroke: "#10B981"
}

habit: {
  label: "habit window\n(reactivation surfaces\nfor returners)"
  style.fill: "#F3E8FD"
}

abandon: {
  label: "abandoned\n(no first task\nor exited tour)"
  style.fill: "#FECACA"
}

reactivation: {
  label: "reactivation surface\n(§18.6 — what changed,\nrecoverable state,\nre-onboarding shortcut)"
  style.fill: "#FEF3E8"
}

arrival -> guided_setup
guided_setup -> sample_data_choice
sample_data_choice -> sample: "sample"
sample_data_choice -> fresh: "fresh"
sample -> first_task
fresh -> first_task
first_task -> aha: "task complete"
first_task -> abandon: "drop-off" {
  style.stroke-dash: 4
}
aha -> habit
abandon -> reactivation: "return after\nthreshold"
reactivation -> first_task: "re-onboard"
