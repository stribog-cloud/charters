# Diátaxis quadrants — Stribog User Documentation Standard §3
# Two axes: practical↔theoretical, acquiring↔applying skill.

direction: right

grid: {
  label: "Diátaxis content model"
  grid-rows: 2
  grid-columns: 2
  grid-gap: 40

  tutorial: {
    label: "Tutorial\n\n• Acquiring skill\n• Practical\n• Carries a beginner end-to-end\n• Single named path\n• Verifiable end state"
    style.fill: "#E8F4FD"
    style.stroke: "#3B82F6"
    style.font-size: 16
  }

  howto: {
    label: "How-To Guide\n\n• Applying skill\n• Practical\n• Task-shaped\n• Verb-first title\n• Ends when goal is met"
    style.fill: "#FEF3E8"
    style.stroke: "#F59E0B"
    style.font-size: 16
  }

  explanation: {
    label: "Explanation\n\n• Acquiring skill\n• Theoretical\n• Concept-shaped\n• Cross-links to ADRs\n• Honest about trade-offs"
    style.fill: "#EEF7EE"
    style.stroke: "#10B981"
    style.font-size: 16
  }

  reference: {
    label: "Reference\n\n• Applying skill\n• Theoretical\n• Surface-shaped\n• Generated where possible\n• Drift-gated"
    style.fill: "#F3E8FD"
    style.stroke: "#8B5CF6"
    style.font-size: 16
  }
}
